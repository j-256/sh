#!/bin/bash
# git-remote-audit - Compare live Git remote branches and tags with local refs
#
# Usage:
#   git-remote-audit [-r] [-v] [-e] [-p policy.json] [directory]
#
# Options:
#   -r, --recursive  Discover repositories at every depth
#   -v, --verbose    Show the complete per-ref report, including matches
#   -e, --explain    Explain differing branches and associated worktrees
#   -p, --policy FILE  Read generic repository expectations from JSON
#   -h, --help       Show help
#
# Dependencies:
#   Git with --no-lazy-fetch support

_git_remote_audit() (
    local SCRIPT_NAME; SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
    case "${BASH_SOURCE[0]}" in /dev/*|/proc/*) SCRIPT_NAME="" ;; esac
    case "$SCRIPT_NAME" in ""|bash|sh|zsh|dash) SCRIPT_NAME="git-remote-audit" ;; esac
    local OID_WIDTH=12
    local RANK_ERROR=0
    local RANK_REVIEW=1
    local RANK_REFS=2
    local RANK_OK=3

    _show_help() {
        local s=""
        local r=""
        if { [ -t 1 ] || [ -n "${CLICOLOR_FORCE:-}" ]; } && [ -z "${NO_COLOR:-}" ]; then
            s=$'\033[4m'
            r=$'\033[24m'
        fi
        cat <<EOF
NAME
  $SCRIPT_NAME - compare branches and tags across Git remotes and local repositories
SYNOPSIS
  $SCRIPT_NAME [${s}options${r}] [${s}directory${r}]
DESCRIPTION
  Queries live branch and tag refs from every named remote's fetch endpoint.
  Reports whether remotes match and compares each with same-named local refs.
  Branch counts are local ahead/behind; tags compare exact object IDs,
  including annotation objects. Uncommitted changes are reported separately.

  The default report has one row per repository, ordered by incomplete
  checks, changes to review, ref-name gaps alone, then matching repositories.
  It shows remote parity and the checked-out branch independently. Other
  differences are counted by unique ref within each category. Use -v on
  one repository to inspect its complete ref inventory, including matches.
  The scan root uses its directory name; nested repositories use relative
  paths so the table stays compact.
  SYNC reports SYNCED, PULL, PUSH, DIVERGED, or UNKNOWN separately from
  housekeeping. Policy can also report LOCAL, PINNED, or DIFFERS.

  Checks the directory itself and its immediate child repository roots.
  The directory defaults to the current directory. Recursive mode also
  finds nested repositories, initialized submodules, and linked worktrees.
  Bare repositories are supported. Descendant directory symlinks, .git
  administration directories, and bare repository internals are not entered.

  Repository refs, objects, index, configuration, and working files are
  preserved. Missing history is fetched into private temporary storage,
  removed on exit. Tracking refs and FETCH_HEAD are not updated.
OPTIONS
  -r, --recursive  Discover repositories at every depth
  -v, --verbose    Show the complete per-ref report, including matches
  -e, --explain    Show focused differences and branch/worktree explanations
  -p, --policy ${s}FILE${r}  Read repository expectations from JSON
  -h, --help       Show this help
  --              Treat remaining arguments as positional
ENVIRONMENT
  TMPDIR          Temporary storage parent (default: /tmp)
  NO_COLOR        Disable help styling, including when CLICOLOR_FORCE is set
  CLICOLOR_FORCE  Enable help styling even when stdout is redirected
DEPENDENCIES
  Git with --no-lazy-fetch support
  Python 3 (required only for --policy)
FILES
  Policy: {"version":1,"repositories":[{"path":"/absolute/project",...}]}
  Each repository requires path and permits localBranch, remote (default
  origin), remoteBranch, mirrors and independent (remote-name arrays),
  sourceOnly and localOnly (booleans), pin (commit ID), problems (string
  array), and note (string). Omitted branches use the live remote default
  branch. Mirrors compare the selected source branch; independent remotes
  are still queried. sourceOnly excludes generated publication refs and
  tags with an explicit coverage note. localOnly expects no remotes.
  pin checks a detached submodule against its parent's committed gitlink.
  problems report adapter preflight failures before remote queries.
  Policy files are limited to 2 MiB. Paths and strings cannot contain control
  characters. Unknown or duplicate
  keys, overlapping roles, duplicate paths, and invalid refs are rejected.
  A policy does not establish remote URL identity; its producer owns that
  check. Unlisted repositories retain ordinary audit behavior.
EXAMPLES
  $SCRIPT_NAME
  $SCRIPT_NAME ~/projects
  $SCRIPT_NAME -rv ~/projects
EXIT STATUS
  0  Audit completed without findings
  1  Incomplete audit, runtime failure, or interruption
  2  Invalid arguments, inaccessible directory, or no repositories found
  3  Git missing or lacking required --no-lazy-fetch support
  4  Differences, dirty working trees, detached HEAD, or no remotes
CAVEATS
  REFS means only names differ; shared ref values match. REVIEW includes
  differing commits or tags, a missing checked-out branch, dirty worktrees,
  detached HEAD, or no remotes. Differences may be intentional.

  Failures take precedence over findings; other repositories and reachable
  remotes are still checked. Unknown results never imply equality.
  Differing shallow-history tips have unknown ahead/behind counts (exit 1).
  Detached HEAD is reported but is not matched to an arbitrary remote branch.
  An unborn HEAD has no local branch ref until its first commit.

  Only advertised refs/heads/* and refs/tags/* are compared. Remote HEAD,
  hosting settings, hidden refs, and separate push URLs are outside scope.
  Git uses the first fetch URL for each remote. Upstream mappings do not
  rename branches for comparison. Remote snapshots are sequential, so this
  is not an atomic comparison across servers. Interrupted network operations
  may require retrying the audit.

  Git authentication and transport configuration are honored. HTTP terminal
  credential prompts are disabled; SSH follows its normal configuration.
  Raw Git error text is withheld because it can contain credential URLs.
  Inherited Git repository-location variables are cleared so each discovered
  on-disk repository is inspected independently.
EOF
    }

    _error() { printf '[ERR][%s] %s\n' "$SCRIPT_NAME" "$*" >&2; }
    _info() { printf '[INF][%s] %s\n' "$SCRIPT_NAME" "$*" >&2; }
    _display() { printf '%q' "$1"; }

    _repo_display() {
        if [ "$repo" = . ]; then _display "$scan_label"
        else _display "$repo"; fi
    }

    _load_policy() {
        [ -n "$policy_file" ] || return 0
        command -v python3 >/dev/null 2>&1 || { _error 'python3 is required'; return 3; }
        if ! python3 - "$policy_file" > "$scratch_root/policy" <<'PY'
import json
import os
import re
import subprocess
import sys

POLICY_VERSION = 1
POLICY_MAX_BYTES = 2 * 1024 * 1024

def pairs(items):
    value = {}
    for key, item in items:
        if key in value:
            raise ValueError()
        value[key] = item
    return value

def text(value):
    return isinstance(value, str) and all(ord(char) >= 32 and ord(char) != 127 for char in value)

try:
    with open(sys.argv[1], 'rb') as stream:
        raw = stream.read(POLICY_MAX_BYTES + 1)
    if len(raw) > POLICY_MAX_BYTES:
        raise ValueError()
    data = json.loads(raw, object_pairs_hook=pairs)
    if not isinstance(data, dict) or set(data) != {'version', 'repositories'} or type(data['version']) is not int or data['version'] != POLICY_VERSION or not isinstance(data['repositories'], list):
        raise ValueError()
    seen = set()
    allowed = {'path', 'localBranch', 'remote', 'remoteBranch', 'mirrors', 'independent', 'sourceOnly', 'localOnly', 'pin', 'problems', 'note'}
    remote_pattern = re.compile(r'[A-Za-z0-9][A-Za-z0-9_-]*(?:[.][A-Za-z0-9_-]+)*')
    for row in data['repositories']:
        if not isinstance(row, dict) or set(row) - allowed or not text(row.get('path')) or not os.path.isabs(row['path']):
            raise ValueError()
        identity = os.path.realpath(row['path'])
        if identity in seen:
            raise ValueError()
        seen.add(identity)
        remote = row.get('remote', 'origin')
        roles = [row.get('mirrors', [remote]), row.get('independent', [])]
        if not text(remote) or not remote_pattern.fullmatch(remote):
            raise ValueError()
        for names in roles:
            if not isinstance(names, list) or any(not text(name) or not remote_pattern.fullmatch(name) for name in names) or len(names) != len(set(names)):
                raise ValueError()
        if set(roles[0]) & set(roles[1]) or remote in roles[1]:
            raise ValueError()
        branches = [row.get('localBranch', ''), row.get('remoteBranch', '')]
        for branch in branches:
            if not text(branch) or (branch and (branch.startswith('-') or subprocess.run(['git', 'check-ref-format', '--branch', branch], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode)):
                raise ValueError()
        flags = [row.get('sourceOnly', False), row.get('localOnly', False)]
        if any(type(flag) is not bool for flag in flags):
            raise ValueError()
        pin = row.get('pin', '')
        if not text(pin) or (pin and not re.fullmatch(r'(?:[0-9a-f]{40}|[0-9a-f]{64})', pin)):
            raise ValueError()
        problems = row.get('problems', [])
        note = row.get('note', '')
        if not isinstance(problems, list) or any(not text(item) for item in problems) or not text(note):
            raise ValueError()
        values = [row['path'], *branches, remote, ','.join(roles[0]), ','.join(roles[1]), *(str(int(flag)) for flag in flags), pin, '; '.join(problems), note]
        print('\t'.join(value if value else '-' for value in values))
except (ValueError, OSError, TypeError, KeyError, RecursionError):
    sys.exit(2)
PY
        then
            _error "Invalid policy; check its schema and values. Run \`$SCRIPT_NAME -h\` for usage"
            return 2
        fi
        local path
        local local_branch
        local remote_branch
        local remote
        local mirrors
        local independent
        local source_only
        local local_only
        local pin
        local problems
        local note
        while IFS=$'\t' read -r path local_branch remote_branch remote mirrors independent source_only local_only pin problems note; do
            policy_paths+=("$path")
            policy_locals+=("$local_branch")
            policy_branches+=("$remote_branch")
            policy_remotes+=("$remote")
            policy_mirrors+=("$mirrors")
            policy_independent+=("$independent")
            policy_sources+=("$source_only")
            policy_local_only+=("$local_only")
            policy_pins+=("$pin")
            policy_problems+=("$problems")
            policy_notes+=("$note")
        done < "$scratch_root/policy"
    }

    _select_policy() {
        local index=0
        while [ "$index" -lt "${#policy_paths[@]}" ]; do
            if [ "$repo" -ef "${policy_paths[$index]}" ]; then repo_policy=$index; return; fi
            index=$((index + 1))
        done
    }

    _snapshot_value() {
        awk -F '\t' -v ref="$2" '$1 == ref { print $2; found = 1; exit } END { if (!found) print "-" }' "$1"
    }

    _expand_short_opts() {
        # $1 = string of short-opt letters that take a value (e.g. "nXHd"); "" for flag-only scripts
        # $2..$N = "$@"
        # Populates _EXPANDED; caller does: set -- "${_EXPANDED[@]}"; unset _EXPANDED
        local value_opts="$1"; shift
        _EXPANDED=()
        local passthru=""
        local arg
        local rest
        local c
        for arg in "$@"; do
            if [ -n "$passthru" ]; then _EXPANDED+=("$arg"); continue; fi
            case "$arg" in
                --)       passthru=1; _EXPANDED+=("$arg") ;;
                --*|-|"") _EXPANDED+=("$arg") ;;
                -[a-zA-Z]?*)
                    rest="${arg#-}"
                    while [ -n "$rest" ]; do
                        c="${rest%"${rest#?}"}"; rest="${rest#?}"
                        _EXPANDED+=("-$c")
                        case "$value_opts" in *"$c"*)
                            [ -n "$rest" ] && _EXPANDED+=("$rest")
                            rest="" ;;
                        esac
                    done ;;
                *)        _EXPANDED+=("$arg") ;;
            esac
        done
    }

    # Keep optional writes and repository hooks out of all inspection commands
    _git() {
        local directory="$1"; shift
        git --no-lazy-fetch --no-replace-objects -C "$directory" \
            -c core.hooksPath=/dev/null -c core.fsmonitor=false \
            -c gc.auto=0 -c maintenance.auto=false -c fetch.writeCommitGraph=false \
            -c fetch.bundleURI= "$@"
    }

    # Git accepts C-quoted alternate paths, including colons and newlines
    _quote_alternate() {
        local path="$1"
        path="${path//\\/\\\\}"
        path="${path//\"/\\\"}"
        path="${path//$'\n'/\\n}"
        path="${path//$'\r'/\\r}"
        path="${path//$'\t'/\\t}"
        printf '"%s"' "$path"
    }

    # Emit the union as ref, left object, right object; '-' means absent
    _ref_pairs() {
        awk -F '\t' '
            FILENAME == ARGV[1] { left[$1] = $2; names[$1] = 1; next }
            { right[$1] = $2; names[$1] = 1 }
            END {
                for (name in names)
                    printf "%s\t%s\t%s\n", name,
                        (name in left ? left[name] : "-"),
                        (name in right ? right[name] : "-")
            }
        ' "$1" "$2" | sort
    }

    _ref_label() {
        case "$1" in
            refs/heads/*) printf 'branch %s' "${1#refs/heads/}" ;;
            refs/tags/*) printf 'tag %s' "${1#refs/tags/}" ;;
        esac
    }

    # The repository context is local to _audit_repository and shared by its helpers
    _object_git() {
        GIT_OBJECT_DIRECTORY="$repo_scratch/objects" \
            GIT_ALTERNATE_OBJECT_DIRECTORIES="$alternate" _git "$repo" "$@"
    }

    _repo_error() {
        repo_error=1
        if [ -z "$repo_problem" ]; then repo_problem="${1%%;*}"; fi
        _error "Repository $(_repo_display): $*"
    }

    _remote_unavailable() {
        if [ -n "$failed_remotes" ]; then failed_remotes="$failed_remotes, "; fi
        failed_remotes="$failed_remotes$1"
        remote_query_failures=$((remote_query_failures + 1))
    }

    _record_difference() {
        local ref="$1"
        local left="$2"
        local right="$3"
        local kind=gap
        if [ "$left" != - ] && [ "$right" != - ]; then
            kind=value
            repo_review=1
        fi
        if [ "$ref" = "refs/heads/$repo_head" ]; then repo_review=1; fi
        printf '%s\t%s\t%s\t%s\n' "$ref" "$kind" "$left" "$right" >> "$repo_scratch/ref-findings"
    }

    _head_summary() {
        if [ "$repo_local_only" -eq 1 ]; then printf '%s local-only (expected)' "$repo_head"; return; fi
        if [ "$repo_pin" != - ]; then printf '%s' "$repo_pin_summary"; return; fi
        if [ "$repo_head_state" = detached ]; then printf 'detached HEAD'; return; fi
        if [ -z "$repo_head" ]; then printf 'repository unavailable'; return; fi
        if [ ! -s "$repo_scratch/head-states" ]; then
            if [ "$repo_head_state" = unborn ]; then printf '%s (unborn)' "$repo_head"
            else printf '%s not checked' "$repo_head"; fi
            return
        fi
        awk -F '\t' -v head="$repo_head" -v head_state="$repo_head_state" -v partial="$failed_remotes" '
            $2 == "match" { matches = matches (length(matches) ? ", " : "") $1; next }
            {
                if (!($2 in groups)) order[++n] = $2
                groups[$2] = groups[$2] (length(groups[$2]) ? ", " : "") $1
            }
            END {
                if (head_state == "unborn") head = head " (unborn)"
                if (!n) {
                    printf "%s matches%s", head, (length(partial) ? " reachable remotes" : "")
                } else {
                    printf "%s: ", head
                    for (i = 1; i <= n; i++) {
                        printf "%s", (i > 1 ? "; " : "")
                        if (order[i] == "missing on remote") printf "absent on %s", groups[order[i]]
                        else if (order[i] == "missing locally") printf "absent locally (%s)", groups[order[i]]
                        else printf "%s vs %s", order[i], groups[order[i]]
                    }
                    if (length(matches)) printf "; matches %s", matches
                }
            }
        ' "$repo_scratch/head-states"
    }

    _other_ref_summary() {
        [ -f "$repo_scratch/ref-findings" ] || { printf '0\t'; return; }
        awk -F '\t' -v head="refs/heads/$repo_head" '
            $1 == head { next }
            {
                if ($2 == "gap") gaps[$1] = 1
                for (i = 3; i <= 4; i++) {
                    if ($i == "-") continue
                    value = "oid:" $i
                    if (($1 in values) && values[$1] != value) changed[$1] = 1
                    values[$1] = value
                }
            }
            function add(n, singular, plural) {
                if (n) { printf "%s%d %s", separator, n, (n == 1 ? singular : plural); separator = "; " }
            }
            END {
                for (ref in changed) {
                    if (ref ~ /^refs\/heads\//) branch_values++; else tag_values++
                }
                for (ref in gaps) {
                    if (ref ~ /^refs\/heads\//) branch_gaps++; else tag_gaps++
                }
                printf "%d\t", branch_values + tag_values
                add(branch_values, "other branch differs", "other branches differ")
                add(tag_values, "tag differs", "tags differ")
                add(branch_gaps, "branch-name gap", "branch-name gaps")
                add(tag_gaps, "tag-name gap", "tag-name gaps")
            }
        ' "$repo_scratch/ref-findings"
    }

    _compact_row() {
        local summary
        local other_refs
        local other_values=0
        local rank="$RANK_OK"
        local state=OK
        if ! summary="$(_head_summary)" || ! other_refs="$(_other_ref_summary)"; then
            _repo_error 'Failed to summarize repository results'
            summary='summary unavailable'
            other_refs=''
        else
            other_values="${other_refs%%$'\t'*}"
            other_refs="${other_refs#*$'\t'}"
        fi
        if [ "$other_values" -gt 0 ]; then repo_review=1; fi
        case "$repo_working_state" in
            dirty) summary="$summary; dirty worktree" ;;
            bare) summary="$summary; bare repository" ;;
            unknown) summary="$summary; working-tree state unknown" ;;
        esac
        if [ -n "$failed_remotes" ]; then
            summary="$summary; unavailable: $failed_remotes"
        elif [ "$repo_error" -eq 1 ]; then
            summary="$summary; $repo_problem"
        elif [ "$repo_remote_state" = none ]; then
            summary="$summary; no remotes"
        fi
        if [ -n "$other_refs" ]; then summary="$summary; $other_refs"; fi
        if [ -n "$repo_note" ]; then summary="$summary; $repo_note"; fi
        if [ "$repo_error" -eq 1 ]; then rank="$RANK_ERROR"; state=ERROR
        elif [ "$repo_review" -eq 1 ]; then rank="$RANK_REVIEW"; state=REVIEW
        elif [ "$repo_finding" -eq 1 ]; then rank="$RANK_REFS"; state=REFS; fi
        local sync
        if [ "$repo_error" -eq 1 ]; then sync=UNKNOWN
        elif [ "$repo_local_only" -eq 1 ]; then sync=LOCAL
        elif [ "$repo_pin" != - ]; then sync="$repo_pin_state"
        else
            sync="$(awk -F '\t' '
                /unknown|not checked|missing/ { unknown = 1 }
                /ahead [1-9]/ { ahead = 1 }
                /behind [1-9]/ { behind = 1 }
                END {
                    if (unknown || !NR) print "UNKNOWN"
                    else if (ahead && behind) print "DIVERGED"
                    else if (ahead) print "PUSH"
                    else if (behind) print "PULL"
                    else print "SYNCED"
                }
            ' "$repo_scratch/head-states")"
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$rank" "$state" "$(_repo_display)" \
            "$repo_remote_state" "$summary" "$sync" >> "$scratch_root/summary"
    }

    _query_failure_summary() {
        if [ "$remote_query_failures" -eq 1 ]; then printf '1 remote query failed\n'
        elif [ "$remote_query_failures" -gt 1 ]; then printf '%s remote queries failed\n' "$remote_query_failures"; fi
    }

    _render_summary() {
        local rows="$scratch_root/summary-sorted"
        if ! sort -t $'\t' -k1,1n -k3,3 "$scratch_root/summary" > "$rows"; then
            _error 'Failed to order summary rows; showing discovery order'
            errors=$((errors + 1))
            rows="$scratch_root/summary"
        fi
        if ! awk -F '\t' -v repositories="$repositories" \
            -v error_rank="$RANK_ERROR" -v review_rank="$RANK_REVIEW" \
            -v refs_rank="$RANK_REFS" -v ok_rank="$RANK_OK" '
            BEGIN { state_width = length("STATE"); repo_width = length("REPOSITORY"); remote_width = length("REMOTES") }
            {
                counts[$1]++
                state[NR] = $2; repo[NR] = $3; remote[NR] = $4; detail[NR] = $5; sync[NR] = $6
                if (length($2) > state_width) state_width = length($2)
                if (length($3) > repo_width) repo_width = length($3)
                if (length($4) > remote_width) remote_width = length($4)
            }
            END {
                if (NR) {
                    printf "%-*s  %-*s  %-8s  %-*s  %s\n", state_width, "STATE", repo_width, "REPOSITORY", "SYNC", remote_width, "REMOTES", "LOCAL / OTHER REFS"
                    for (i = 1; i <= NR; i++)
                        printf "%-*s  %-*s  %-8s  %-*s  %s\n", state_width, state[i], repo_width, repo[i], sync[i], remote_width, remote[i], detail[i]
                    printf "\n"
                }
                printf "Summary: %d repositor%s, %d matching, %d review, %d refs-only, %d incomplete\n", repositories,
                    (repositories == 1 ? "y" : "ies"),
                    counts[ok_rank], counts[review_rank], counts[refs_rank], counts[error_rank]
            }
        ' "$rows"; then
            _error 'Failed to render summary'
            errors=$((errors + 1))
        fi
        if [ "$scan_errors" -gt 0 ]; then printf '%s directory scan errors\n' "$scan_errors"; fi
        _query_failure_summary
        printf 'REFS = names differ only; shared refs match\n'
        printf 'Details for one repo: %s -v <repository>\n' "$SCRIPT_NAME"
        if [ "$explain" -eq 1 ]; then cat "$scratch_root/explanations"; fi
    }

    _apply_policy() {
        local source_remote="${policy_remotes[$repo_policy]}"
        local source_branch="${policy_branches[$repo_policy]}"
        local local_branch="${policy_locals[$repo_policy]}"
        local mirrors="${policy_mirrors[$repo_policy]}"
        local independent="${policy_independent[$repo_policy]}"
        local source_only="${policy_sources[$repo_policy]}"
        local index=0
        local source_index=-1
        local remote
        local left
        local right
        local left_ref
        local right_ref
        local ref
        local counts
        local ahead
        local behind
        local state
        local peers=''
        local available=,
        local expected
        local expected_roles=()
        repo_review=0
        repo_finding=0
        case "$repo_working_state" in dirty|unknown) repo_review=1; repo_finding=1 ;; esac
        repo_local_only="${policy_local_only[$repo_policy]}"
        repo_pin="${policy_pins[$repo_policy]}"
        repo_note="${policy_notes[$repo_policy]}"
        if [ "$repo_note" = - ]; then repo_note=''; fi
        if [ "$repo_pin" = - ] && [ "$repo_head_state" = detached ]; then
            repo_note="${repo_note:+$repo_note; }checkout has detached HEAD"
            repo_review=1
            repo_finding=1
        fi
        if [ "$repo_local_only" -eq 1 ]; then
            if [ "${#remotes[@]}" -ne 0 ]; then _repo_error 'Local-only policy has configured remotes'; fi
            repo_remote_state=none
            return
        fi
        if [ "$repo_pin" != - ]; then
            repo_remote_state=pin
            if [ "$(_git "$repo" rev-parse --verify HEAD 2>/dev/null)" = "$repo_pin" ]; then
                repo_pin_summary='pinned submodule matches committed gitlink'
                repo_pin_state=PINNED
            else
                repo_pin_summary='submodule differs from committed gitlink'
                repo_pin_state=DIFFERS
                repo_review=1
                repo_finding=1
            fi
            repo_note='submodule remote refs are outside pin audit'
            return
        fi
        while [ "$index" -lt "${#remotes[@]}" ]; do
            if [ "${remotes[$index]}" = "$source_remote" ]; then source_index=$index; fi
            available="$available${remotes[$index]},"
            index=$((index + 1))
        done
        IFS=, read -r -a expected_roles <<< "$mirrors,$independent"
        for expected in "${expected_roles[@]}"; do
            case "$expected" in ''|-) continue ;; esac
            case "$available" in *",$expected,"*) ;; *) _repo_error "Declared remote '$expected' is missing" ;; esac
        done
        if [ "$source_index" -lt 0 ]; then _repo_error "Declared source remote '$source_remote' is missing"; return; fi
        if [ "$source_branch" = - ]; then
            source_branch="$(cat "$repo_scratch/default-$source_index")"
            source_branch="${source_branch#refs/heads/}"
        fi
        if [ -z "$source_branch" ]; then _repo_error 'Remote default branch unavailable; declare the source branch explicitly'; return; fi
        if [ "$local_branch" = - ]; then local_branch="$source_branch"; fi
        repo_head="$local_branch"
        repo_head_state=branch
        left="$(_snapshot_value "$repo_scratch/local" "refs/heads/$local_branch")"
        index=0
        while [ "$index" -lt "${#remotes[@]}" ]; do
            remote="${remotes[$index]}"
            case ",$independent," in
                *",$remote,"*)
                    repo_note="${repo_note:+$repo_note; }independent: $remote (upstream integration not checked)"
                    index=$((index + 1))
                    continue
                    ;;
            esac
            if [ "$remote" != "$source_remote" ]; then
                case ",$mirrors," in
                    *",$remote,"*) ;;
                    *)
                        repo_note="${repo_note:+$repo_note; }unclassified remote: $remote"
                        if [ "${remote_ok[$index]}" -eq 1 ]; then
                            _compare_local "$remote" "$repo_scratch/remote-$index"
                            if [ "${remote_ok[$source_index]}" -eq 1 ] && _ref_pairs "$repo_scratch/remote-$source_index" "$repo_scratch/remote-$index" > "$repo_scratch/unclassified-refs"; then
                                while IFS=$'\t' read -r ref left_ref right_ref; do
                                    [ "$left_ref" != "$right_ref" ] || continue
                                    repo_finding=1
                                    _record_difference "$ref" "$left_ref" "$right_ref"
                                done < "$repo_scratch/unclassified-refs"
                            fi
                        fi
                        index=$((index + 1))
                        continue
                        ;;
                esac
            fi
            peers="${peers:+$peers, }$remote/$source_branch"
            if [ "${remote_ok[$index]}" -ne 1 ]; then
                printf '%s\thistory unknown\n' "$remote" >> "$repo_scratch/head-states"
                index=$((index + 1))
                continue
            fi
            right="$(_snapshot_value "$repo_scratch/remote-$index" "refs/heads/$source_branch")"
            if [ "$left" = - ]; then state='missing locally'
            elif [ "$right" = - ]; then state='missing on remote'
            elif [ "$left" = "$right" ]; then state=match
            else
                printf 'refs/heads/%s\t%s\t%s\n' "$source_branch" "$left" "$right" > "$repo_scratch/policy-pair"
                _prepare_history "$remote" "$repo_scratch/policy-pair"
                if [ "$shallow" = true ] || ! counts="$(_object_git rev-list --left-right --count "$left...$right" -- 2>"$repo_scratch/error")"; then
                    state='history unknown'
                    _repo_error "Source ancestry unavailable for '$remote'"
                else
                    read -r ahead behind <<< "$counts"
                    if [ "$ahead" -eq 0 ]; then state="behind $behind"
                    elif [ "$behind" -eq 0 ]; then state="ahead $ahead"
                    else state="diverged (ahead $ahead, behind $behind)"; fi
                fi
            fi
            printf '%s\t%s\n' "$remote" "$state" >> "$repo_scratch/head-states"
            printf '  Source %s -> %s/%s: %s\n' "$local_branch" "$remote" "$source_branch" "$state"
            if [ "$state" != match ]; then
                repo_review=1
                repo_finding=1
                _record_difference "refs/heads/$local_branch" "$left" "$right"
            fi
            if ! _ref_pairs "$repo_scratch/local" "$repo_scratch/remote-$index" > "$repo_scratch/policy-refs"; then
                _repo_error "Failed to compare remaining refs for '$remote'"
                index=$((index + 1))
                continue
            fi
            while IFS=$'\t' read -r ref left_ref right_ref; do
                case "$ref" in "refs/heads/$local_branch"|"refs/heads/$source_branch") continue ;; esac
                if [ "$source_only" -eq 1 ]; then
                    case "$ref" in refs/tags/*) continue ;; esac
                    [ "$left_ref" != - ] || continue
                fi
                if [ "$left_ref" = "$right_ref" ]; then
                    if [ "$verbose" -eq 1 ]; then printf '    %s: match [%s]\n' "$(_ref_label "$ref")" "$remote"; fi
                    continue
                fi
                repo_finding=1
                _record_difference "$ref" "$left_ref" "$right_ref"
                if [ "$verbose" -eq 1 ]; then
                    if [ "$left_ref" = - ]; then state='missing locally'
                    elif [ "$right_ref" = - ]; then state='missing on remote'
                    else state="differs (local=${left_ref:0:OID_WIDTH}, remote=${right_ref:0:OID_WIDTH})"; fi
                    printf '    %s: %s [%s]\n' "$(_ref_label "$ref")" "$state" "$remote"
                fi
            done < "$repo_scratch/policy-refs"
            index=$((index + 1))
        done
        repo_remote_state=policy
        repo_note="${repo_note:+$repo_note; }source: $peers"
        if [ "$source_only" -eq 1 ]; then repo_note="$repo_note; publication refs not checked"; fi
    }

    _explain_repository() {
        local ref
        local oid
        local path
        local head
        local tree
        local ancestor
        local detail
        local index=0
        local remote
        printf '\nRepository: %s\n' "$(_repo_display)"
        if [ "$repo_error" -eq 1 ]; then printf '  ERROR %s\n' "$repo_problem"; fi
        if [ -n "$repo_note" ]; then printf '  POLICY %s\n' "$repo_note"; fi
        [ "$repo_pin" = - ] || return 0
        head="$(_git "$repo" rev-parse --verify "refs/heads/$repo_head" 2>/dev/null)" || head=''
        : > "$repo_scratch/trees"
        if [ -n "$head" ]; then
            _git "$repo" log --format='%T%x09%H' "$head" -- > "$repo_scratch/trees" 2>"$repo_scratch/error" || _repo_error 'Cannot inspect integration trees'
        fi
        _git "$repo" for-each-ref --format='%(refname)%09%(objectname)%09%(worktreepath)' refs/heads/ > "$repo_scratch/branches" 2>"$repo_scratch/error" || { _repo_error 'Cannot inspect branch worktrees'; return; }
        while IFS=$'\t' read -r ref oid path; do
            [ "$ref" != "refs/heads/$repo_head" ] || continue
            detail='ancestry unavailable; review'
            if [ -n "$head" ]; then
                if _git "$repo" merge-base --is-ancestor "$oid" "$head" 2>/dev/null; then
                    detail='integrated; cleanup candidate'
                else
                    tree="$(_git "$repo" rev-parse "$oid^{tree}" 2>/dev/null)" || tree=''
                    ancestor="$(awk -F '\t' -v tree="$tree" '$1 == tree { print $2; exit }' "$repo_scratch/trees")"
                    if [ -n "$ancestor" ]; then detail="equivalent tree at ${ancestor:0:OID_WIDTH}; cleanup candidate"
                    else detail='commits absent by ancestry; review'; fi
                fi
            fi
            if [ -n "$path" ]; then
                if ! _git "$path" status --porcelain=v1 -z --untracked-files=normal > "$repo_scratch/associated-status" 2>"$repo_scratch/error"; then
                    detail='worktree status unavailable; preserve'
                    _repo_error 'Cannot inspect an associated worktree'
                elif [ -s "$repo_scratch/associated-status" ]; then
                    detail='worktree dirty; preserve'
                    repo_review=1
                    repo_finding=1
                    repo_note="${repo_note:+$repo_note; }associated worktree dirty"
                fi
            fi
            printf '  LOCAL %s: %s' "${ref#refs/heads/}" "$detail"
            if [ -n "$path" ]; then printf '; worktree: %s' "$(_display "$path")"; fi
            printf '\n'
        done < "$repo_scratch/branches"
        while [ "$index" -lt "${#remotes[@]}" ]; do
            remote="${remotes[$index]}"
            if [ "$repo_policy" -ge 0 ]; then
                case ",${policy_independent[$repo_policy]}," in *",$remote,"*) index=$((index + 1)); continue ;; esac
                if [ "${policy_sources[$repo_policy]}" -eq 1 ]; then index=$((index + 1)); continue; fi
            fi
            if [ "${remote_ok[$index]}" -eq 1 ]; then
                while IFS=$'\t' read -r ref oid; do
                    case "$ref" in refs/heads/*) ;; *) continue ;; esac
                    [ "$ref" != "refs/heads/$repo_head" ] || continue
                    local value; value="$(_snapshot_value "$repo_scratch/local" "$ref")"
                    [ "$value" != "$oid" ] || continue
                    if [ "$value" = - ]; then detail='absent locally; review'
                    else detail='differs from local branch; review'; fi
                    if [ -n "$head" ] && _object_git merge-base --is-ancestor "$oid" "$head" 2>/dev/null; then detail='integrated; cleanup candidate'; fi
                    printf '  REMOTE %s/%s: %s\n' "$remote" "${ref#refs/heads/}" "$detail"
                done < "$repo_scratch/remote-$index"
            fi
            index=$((index + 1))
        done
        if [ -f "$repo_scratch/ref-findings" ]; then
            awk -F '\t' '$1 ~ /^refs\/tags\// && $2 == "value" && !seen[$1]++ { sub(/^refs\/tags\//, "", $1); print "  TAG " $1 ": differing values; use --verbose for object IDs" }' "$repo_scratch/ref-findings"
        fi
    }

    _prepare_history() {
        local remote="$1"
        local pairs="$2"
        local ref
        local left
        local right
        : > "$repo_scratch/wants"
        [ "$shallow" = false ] || return 0
        while IFS=$'\t' read -r ref left right; do
            case "$ref" in refs/heads/*) ;; *) continue ;; esac
            [ "$left" != - ] && [ "$right" != - ] && [ "$left" != "$right" ] || continue
            if ! _object_git rev-list --left-right --count "$left...$right" -- \
                > /dev/null 2>"$repo_scratch/error"; then
                printf '%s\n' "$ref" >> "$repo_scratch/wants"
            fi
        done < "$pairs"
        [ -s "$repo_scratch/wants" ] || return 0
        _info "Reading missing history from remote '$remote' in $(_repo_display)"
        # Concrete source-only refspecs and an empty refmap prevent any ref update
        _object_git fetch --quiet --no-tags --no-prune --no-prune-tags \
            --no-write-fetch-head --no-auto-maintenance --no-recurse-submodules \
            --refmap= --stdin -- "$remote" < "$repo_scratch/wants" \
            > /dev/null 2>"$repo_scratch/error"
        local result=$?
        if [ "$result" -ne 0 ]; then
            _repo_error "Failed to read history from remote '$remote' (Git exit $result); check transport access and retry"
        fi
    }

    _compare_local() {
        local remote="$1"
        local snapshot="$2"
        local ref
        local left
        local right
        local label
        local counts
        local ahead
        local behind
        local state
        local differs=0
        local unknown=0
        local ref_count=0
        local ref_unit=refs
        local details="$repo_scratch/local-details"
        local pairs="$repo_scratch/pairs"
        if ! _ref_pairs "$repo_scratch/local" "$snapshot" > "$pairs"; then
            printf '%s\tnot checked\n' "$remote" >> "$repo_scratch/head-states"
            _repo_error "Failed to compare local refs with remote '$remote'"
            return
        fi
        _prepare_history "$remote" "$pairs"
        : > "$details"
        while IFS=$'\t' read -r ref left right; do
            ref_count=$((ref_count + 1))
            if [ "$left" = "$right" ]; then
                if [ "$ref" = "refs/heads/$repo_head" ]; then
                    printf '%s\tmatch\n' "$remote" >> "$repo_scratch/head-states"
                fi
                if [ "$verbose" -eq 1 ]; then printf '    %s: match\n' "$(_ref_label "$ref")" >> "$details"; fi
                continue
            fi
            label="$(_ref_label "$ref")"
            differs=1
            repo_finding=1
            _record_difference "$ref" "$left" "$right"
            if [ "$left" = - ]; then
                state='missing locally'
            elif [ "$right" = - ]; then
                state='missing on remote'
            elif [ "${ref#refs/tags/}" != "$ref" ]; then
                state="differs (local=${left:0:OID_WIDTH}, remote=${right:0:OID_WIDTH})"
            elif [ "$shallow" = true ]; then
                state='differs (ahead/behind unknown: shallow history)'
                unknown=1
            elif counts="$(_object_git rev-list --left-right --count "$left...$right" -- 2>"$repo_scratch/error")"; then
                read -r ahead behind <<< "$counts"
                if [ "$ahead" -gt 0 ] && [ "$behind" -gt 0 ]; then
                    state="diverged (ahead $ahead, behind $behind)"
                else
                    state="ahead $ahead, behind $behind"
                fi
            else
                state='differs (ahead/behind unknown: history unavailable)'
                unknown=1
            fi
            if [ "$ref" = "refs/heads/$repo_head" ]; then
                local head_state="$state"
                if [ "$left" != - ] && [ "$right" != - ]; then
                    if [ "$shallow" = true ] || [ "$state" = 'differs (ahead/behind unknown: history unavailable)' ]; then
                        head_state='history unknown'
                    elif [ "$ahead" -eq 0 ]; then head_state="behind $behind"
                    elif [ "$behind" -eq 0 ]; then head_state="ahead $ahead"; fi
                fi
                printf '%s\t%s\n' "$remote" "$head_state" >> "$repo_scratch/head-states"
            fi
            printf '    %s: %s\n' "$label" "$state" >> "$details"
        done < "$pairs"
        if [ "$unknown" -eq 1 ]; then
            printf '  Local vs %s: incomplete\n' "$remote"
            _repo_error "Ahead/behind counts unavailable for remote '$remote'; inspect shallow history or retry after remote changes"
        elif [ "$differs" -eq 1 ]; then
            printf '  Local vs %s: differ\n' "$remote"
        else
            if [ "$ref_count" -eq 1 ]; then ref_unit=ref; fi
            printf '  Local vs %s: match (%s %s)\n' "$remote" "$ref_count" "$ref_unit"
        fi
        cat "$details"
    }

    _compare_remotes() {
        local baseline=-1
        local index=0
        local differ=0
        local comparison_failed=0
        local ref
        local left
        local right
        local pair_file="$repo_scratch/remote-pairs"
        local details="$repo_scratch/remote-details"
        : > "$details"
        while [ "$index" -lt "${#remotes[@]}" ]; do
            if [ "${remote_ok[$index]}" -eq 1 ]; then
                if [ "$baseline" -lt 0 ]; then
                    baseline=$index
                elif _ref_pairs "$repo_scratch/remote-$baseline" "$repo_scratch/remote-$index" > "$pair_file"; then
                    while IFS=$'\t' read -r ref left right; do
                        if [ "$left" = "$right" ]; then
                            [ "$verbose" -eq 1 ] || continue
                        else
                            differ=1
                            repo_finding=1
                            _record_difference "$ref" "$left" "$right"
                        fi
                        if [ "$left" = - ]; then left=missing; else left="${left:0:OID_WIDTH}"; fi
                        if [ "$right" = - ]; then right=missing; else right="${right:0:OID_WIDTH}"; fi
                        printf '    %s: %s=%s %s=%s\n' "$(_ref_label "$ref")" \
                            "${remotes[$baseline]}" "$left" "${remotes[$index]}" "$right" >> "$details"
                    done < "$pair_file"
                else
                    comparison_failed=1
                    _repo_error 'Failed to compare remote snapshots'
                fi
            fi
            index=$((index + 1))
        done
        if [ "$comparison_failed" -eq 1 ]; then
            repo_remote_state=unknown
            printf '  Remotes: unknown (snapshot comparison failed)\n'
        elif [ "$reachable" -ne "${#remotes[@]}" ]; then
            repo_remote_state=unknown
            printf '  Remotes: unknown (%s/%s reachable)\n' "$reachable" "${#remotes[@]}"
        elif [ "${#remotes[@]}" -eq 1 ]; then
            repo_remote_state=single
            printf '  Remotes: not comparable (1 remote)\n'
        elif [ "$differ" -eq 1 ]; then
            repo_remote_state="differ (${#remotes[@]})"
            printf '  Remotes: differ\n'
        else
            repo_remote_state="match (${#remotes[@]})"
            printf '  Remotes: match (%s remotes)\n' "${#remotes[@]}"
        fi
        cat "$details"
    }

    _inspect_repository() {
        local bare
        local head
        local objects_path
        local remote
        local index=0
        local result
        local metadata=.
        if [ -e "$repo/.git" ] || [ -L "$repo/.git" ]; then metadata=.git; fi
        # Validate the candidate itself before Git can search a parent repository
        if ! _git "$repo" rev-parse --resolve-git-dir "$metadata" > /dev/null 2>"$repo_scratch/error" \
            || ! bare="$(_git "$repo" rev-parse --is-bare-repository 2>"$repo_scratch/error")"; then
            _repo_error 'Cannot read Git repository metadata'
            return
        fi
        if [ "$bare" = true ]; then
            repo_working_state=bare
            printf '  Working tree: bare\n'
        elif _git "$repo" status --porcelain=v1 -z --untracked-files=normal > "$repo_scratch/status" 2>"$repo_scratch/error"; then
            if [ -s "$repo_scratch/status" ]; then
                repo_working_state=dirty
                repo_review=1
                printf '  Working tree: dirty (staged, unstaged or untracked changes)\n'
                repo_finding=1
            else
                repo_working_state=clean
                printf '  Working tree: clean\n'
            fi
        else
            printf '  Working tree: unknown\n'
            _repo_error 'Failed to read working-tree status'
        fi
        head="$(_git "$repo" symbolic-ref -q HEAD 2>"$repo_scratch/error")"
        head="${head#refs/heads/}"
        repo_head="$head"
        if [ -z "$head" ]; then
            repo_head_state=detached
            repo_review=1
            printf '  HEAD: detached (compared named refs only)\n'
            repo_finding=1
        elif _git "$repo" rev-parse --verify -q HEAD > /dev/null 2>"$repo_scratch/error"; then
            repo_head_state=branch
            printf '  HEAD: %s\n' "$head"
        else
            repo_head_state=unborn
            printf '  HEAD: unborn %s\n' "$head"
        fi
        if ! _git "$repo" for-each-ref --format='%(refname)%09%(objectname)' refs/heads/ refs/tags/ \
            > "$repo_scratch/local" 2>"$repo_scratch/error"; then
            _repo_error 'Failed to read local branch and tag refs'
            return
        fi
        if ! _git "$repo" remote > "$repo_scratch/remotes" 2>"$repo_scratch/error"; then
            _repo_error 'Failed to enumerate remotes'
            return
        fi
        while IFS= read -r remote; do
            [ -n "$remote" ] || continue
            remotes+=("$remote")
        done < "$repo_scratch/remotes"
        if [ "${#remotes[@]}" -eq 0 ]; then
            repo_remote_state=none
            if [ "$repo_policy" -ge 0 ]; then _apply_policy; return; fi
            repo_review=1
            printf '  Remotes: none\n'
            repo_finding=1
            return
        fi
        if ! objects_path="$(_git "$repo" rev-parse --path-format=absolute --git-path objects 2>"$repo_scratch/error")" \
            || ! shallow="$(_git "$repo" rev-parse --is-shallow-repository 2>"$repo_scratch/error")"; then
            _repo_error 'Failed to locate repository history'
            return
        fi
        alternate="$(_quote_alternate "$objects_path")"
        for remote in "${remotes[@]}"; do
            : > "$repo_scratch/default-$index"
            if [ "$repo_policy" -ge 0 ]; then
                _git "$repo" ls-remote --symref -- "$remote" HEAD 'refs/heads/*' 'refs/tags/*' \
                    > "$repo_scratch/advertisement" 2>"$repo_scratch/error"
            else
                _git "$repo" ls-remote --refs -- "$remote" 'refs/heads/*' 'refs/tags/*' \
                    > "$repo_scratch/advertisement" 2>"$repo_scratch/error"
            fi
            result=$?
            remote_ok+=(0)
            if [ "$result" -ne 0 ]; then
                _remote_unavailable "$remote"
                _repo_error "Failed to query remote '$remote' (Git exit $result); check connectivity and authentication"
            elif awk -v policy="$repo_policy" -v defaults="$repo_scratch/default-$index" '
                policy >= 0 && $1 == "ref:" && NF == 3 && $2 ~ /^refs\/heads\// && $3 == "HEAD" { print $2 > defaults; next }
                NF != 2 || $1 !~ /^[0-9a-f]+$/ || (length($1) != 40 && length($1) != 64) { exit 1 }
                policy >= 0 && $2 == "HEAD" { next }
                policy >= 0 && $2 ~ /^refs\/tags\/.*\^\{\}$/ { next }
                $2 !~ /^refs\/(heads|tags)\// { exit 1 }
                { printf "%s\t%s\n", $2, $1 }
            ' "$repo_scratch/advertisement" > "$repo_scratch/remote-$index"; then
                remote_ok[index]=1
                reachable=$((reachable + 1))
            else
                _remote_unavailable "$remote"
                _repo_error "Invalid ref advertisement from remote '$remote'"
            fi
            index=$((index + 1))
        done
        if [ "$repo_policy" -ge 0 ]; then _apply_policy; return; fi
        _compare_remotes
        index=0
        for remote in "${remotes[@]}"; do
            if [ "${remote_ok[$index]}" -eq 1 ]; then
                _compare_local "$remote" "$repo_scratch/remote-$index"
            else
                printf '  Local vs %s: unknown (remote unavailable)\n' "$remote"
            fi
            index=$((index + 1))
        done
    }

    _audit_repository() {
        local repo="$1"
        local repo_error=0
        local repo_finding=0
        local repo_review=0
        local repo_problem=''
        local repo_head=''
        local repo_head_state=unknown
        local repo_working_state=unknown
        local repo_remote_state=unknown
        local repo_policy=-1
        local repo_local_only=0
        local repo_pin=-
        local repo_pin_summary=''
        local repo_pin_state=UNKNOWN
        local repo_note=''
        local failed_remotes=''
        local repo_scratch="$scratch_root/$repositories"
        local alternate
        local shallow
        local remotes=()
        local remote_ok=()
        local reachable=0
        repositories=$((repositories + 1))
        _select_policy
        if [ "$verbose" -eq 1 ]; then printf 'Repository: %s\n' "$(_repo_display)"; fi
        if mkdir -p "$repo_scratch/objects"; then
            : > "$repo_scratch/ref-findings"
            : > "$repo_scratch/head-states"
            if [ "$repo_policy" -ge 0 ] && [ "${policy_problems[$repo_policy]}" != - ]; then
                _repo_error "${policy_problems[$repo_policy]}"
            elif [ "$verbose" -eq 1 ]; then _inspect_repository
            else _inspect_repository > /dev/null; fi
            if [ "$verbose" -eq 1 ] && [ "$repo_policy" -ge 0 ]; then
                printf '  Scope: %s\n' "$(_head_summary)"
                if [ -n "$repo_note" ]; then printf '  Policy: %s\n' "$repo_note"; fi
            fi
            if [ "$explain" -eq 1 ]; then _explain_repository >> "$scratch_root/explanations"; fi
        else
            _repo_error 'Failed to create temporary object storage'
        fi
        if [ "$verbose" -eq 1 ]; then printf '\n'
        elif ! _compact_row; then _repo_error 'Failed to write summary row'; fi
        findings=$((findings + repo_finding))
        errors=$((errors + repo_error))
    }

    _scan() {
        local directory="$1"
        local depth="$2"
        local child
        if [ ! -r "$directory" ] || [ ! -x "$directory" ]; then
            _error "Cannot scan directory $(_display "$directory")"
            errors=$((errors + 1))
            scan_errors=$((scan_errors + 1))
            return
        fi
        if [ -e "$directory/.git" ] || [ -L "$directory/.git" ]; then
            _audit_repository "$directory"
        elif [ -f "$directory/HEAD" ] && [ -d "$directory/objects" ] \
            && [ "$(_git "$directory" rev-parse --is-bare-repository 2>/dev/null)" = true ]; then
            _audit_repository "$directory"
            return
        fi
        if [ "$recursive" -eq 0 ] && [ "$depth" -ge 1 ]; then return; fi
        for child in "$directory"/*; do
            [ -d "$child" ] && [ ! -L "$child" ] || continue
            [ "${child##*/}" != .git ] || continue
            _scan "$child" "$((depth + 1))"
        done
    }

    local recursive=0
    local verbose=0
    local explain=0
    local policy_file=''
    local policy_paths=()
    local policy_locals=()
    local policy_branches=()
    local policy_remotes=()
    local policy_mirrors=()
    local policy_independent=()
    local policy_sources=()
    local policy_local_only=()
    local policy_pins=()
    local policy_problems=()
    local policy_notes=()
    local positional=()
    _expand_short_opts "p" "$@"
    set -- "${_EXPANDED[@]}"; unset _EXPANDED
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) _show_help; return 0 ;;
            -r|--recursive) recursive=1; shift ;;
            -v|--verbose) verbose=1; shift ;;
            -e|--explain) explain=1; shift ;;
            --policy=*) set -- --policy "${1#--policy=}" "${@:2}" ;;
            -p|--policy)
                [ "$#" -ge 2 ] && [ -n "$2" ] || { _error "Must provide a policy file. Run \`$SCRIPT_NAME -h\` for usage"; return 2; }
                policy_file="$2"
                case "$policy_file" in /*) ;; *) policy_file="$PWD/$policy_file" ;; esac
                shift 2
                ;;
            --) shift; while [ $# -gt 0 ]; do positional+=("$1"); shift; done ;;
            -*) _error "Unknown argument '$1'. Run \`$SCRIPT_NAME -h\` for usage"; return 2 ;;
            *) positional+=("$1"); shift ;;
        esac
    done
    if [ "${#positional[@]}" -gt 1 ]; then
        _error "Multiple directories not allowed. Run \`$SCRIPT_NAME -h\` for usage"
        return 2
    fi
    if ! command -v git >/dev/null 2>&1; then _error 'git is required'; return 3; fi
    if ! git --no-lazy-fetch --version >/dev/null 2>&1; then
        _error 'git with --no-lazy-fetch support is required'
        return 3
    fi
    local directory="${positional[0]-.}"
    if [ ! -d "$directory" ] || ! cd -- "$directory" 2>/dev/null; then
        _error "Cannot access directory $(_display "$directory"). Run \`$SCRIPT_NAME -h\` for usage"
        return 2
    fi
    local scan_label="${PWD##*/}"
    if [ -z "$scan_label" ]; then scan_label=/; fi

    unset GIT_DIR GIT_COMMON_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
    unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_PREFIX GIT_SHALLOW_FILE
    export LC_ALL=C GIT_OPTIONAL_LOCKS=0 GIT_TERMINAL_PROMPT=0 GIT_NO_LAZY_FETCH=1
    set -o pipefail
    shopt -s dotglob nullglob
    umask 077
    local scratch_root
    if ! scratch_root="$(mktemp -d "${TMPDIR:-/tmp}/git-remote-audit.XXXXXX")"; then
        _error 'Failed to create temporary storage'
        return 1
    fi
    trap 'rm -rf -- "$scratch_root"' EXIT
    trap 'exit 1' HUP INT TERM
    local repositories=0
    local findings=0
    local errors=0
    local scan_errors=0
    local remote_query_failures=0
    : > "$scratch_root/summary"
    : > "$scratch_root/explanations"
    _load_policy || return $?
    _scan . 0
    local repository_unit=repositories
    local error_unit=errors
    if [ "$repositories" -eq 1 ]; then repository_unit=repository; fi
    if [ "$errors" -eq 1 ]; then error_unit=error; fi
    if [ "$verbose" -eq 1 ]; then
        printf 'Summary: %s %s, %s with findings, %s %s\n' "$repositories" "$repository_unit" "$findings" "$errors" "$error_unit"
        _query_failure_summary
        if [ "$explain" -eq 1 ]; then cat "$scratch_root/explanations"; fi
    else
        _render_summary
    fi
    if [ "$errors" -gt 0 ]; then return 1; fi
    if [ "$repositories" -eq 0 ]; then _error 'No Git repositories found'; return 2; fi
    if [ "$findings" -gt 0 ]; then return 4; fi
    return 0
)

if _git_remote_audit "$@"; then
    __git_remote_audit_rc=0
else
    __git_remote_audit_rc=$?
fi
unset -f _git_remote_audit
if [ -n "${BASH_SOURCE[0]}" ] && [ "${BASH_SOURCE[0]}" != "$0" ]; then
    eval "unset __git_remote_audit_rc; return $__git_remote_audit_rc"
fi
eval "unset __git_remote_audit_rc; exit $__git_remote_audit_rc"
